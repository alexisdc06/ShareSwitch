<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ForceDesignerDpiAwareness>true</ForceDesignerDpiAwareness>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Code quality: full analyzers + style enforcement.
       Warnings stay warnings locally (so F5 always works) but CI runs with
       -warnaserror, so nothing sloppy reaches main. -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <!-- App identity (Version is overridden by CI from the git tag on releases) -->
  <PropertyGroup>
    <Version>0.4.0</Version>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <AssemblyTitle>ShareSwitch</AssemblyTitle>
    <Product>ShareSwitch</Product>
    <Company>AC Design Studio</Company>
    <Copyright>© 2026 AC Design Studio</Copyright>
    <Description>Switch the window you share in video calls without stopping the share.</Description>
  </PropertyGroup>

</Project>
