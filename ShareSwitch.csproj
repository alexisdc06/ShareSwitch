<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ForceDesignerDpiAwareness>true</ForceDesignerDpiAwareness>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Code quality: full analyzers + style enforcement.
       Warnings stay warnings locally (so F5 always works) but CI runs with
       -warnaserror, so nothing sloppy reaches main. -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <!-- App identity (Version is overridden by CI from the git tag on releases) -->
  <PropertyGroup>
    <Version>0.6.4</Version>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <AssemblyTitle>ShareSwitch</AssemblyTitle>
    <Product>ShareSwitch</Product>
    <Company>AC Design Studio</Company>
    <Copyright>© 2026 AC Design Studio</Copyright>
    <Description>Switch the window you share in video calls without stopping the share.</Description>
  </PropertyGroup>

  <!-- Brand resources, embedded so the single-file exe stays self-contained.
       Replace a file in assets\ and rebuild to change the shipped design.
       Figtree is SIL OFL 1.1 (assets\fonts\OFL.txt) — a licensed stand-in for Aeonik. -->
  <ItemGroup>
    <EmbeddedResource Include="assets\backdrop.jpg" LogicalName="ShareSwitch.backdrop.jpg" />
    <EmbeddedResource Include="assets\lockup-white.png" LogicalName="ShareSwitch.lockup-white.png" />
    <EmbeddedResource Include="assets\icon.ico" LogicalName="ShareSwitch.icon.ico" />
    <EmbeddedResource Include="assets\fonts\Figtree-Bold.ttf" LogicalName="ShareSwitch.fonts.Figtree-Bold.ttf" />
    <EmbeddedResource Include="assets\fonts\Figtree-Regular.ttf" LogicalName="ShareSwitch.fonts.Figtree-Regular.ttf" />
    <EmbeddedResource Include="assets\fonts\Figtree-LightItalic.ttf" LogicalName="ShareSwitch.fonts.Figtree-LightItalic.ttf" />
  </ItemGroup>

</Project>
